# =============================================================================
# SultiAI — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Run `npm run check:secrets` before committing. See docs/SECRETS.md.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Supabase -----------------------------------------------------------------
# Server-side (Vite middleware + AI gateway)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: pin JWT verification to your project's JWKS endpoint
SUPABASE_JWKS_URL=

# Client-side (exposed to the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
#
# OAuth / email-link callback. Google sign-in, email-confirmation links and
# password-recovery links all return to
# `${window.location.origin}/auth/callback` (see src/services/authRedirect.ts),
# so BOTH of these must be configured before login works:
#
#   Supabase → Authentication → URL Configuration
#     Site URL:      http://localhost:3000
#     Redirect URLs: http://localhost:3000/auth/callback
#                    https://your-production-domain/auth/callback
#
#   Google Cloud Console → APIs & Services → Credentials → OAuth client
#     Authorized redirect URI: https://YOUR-PROJECT.supabase.co/auth/v1/callback
#     (this is Supabase's callback, NOT the app URL — never put the app URL here)
#
#   Supabase → Authentication → Providers → Google: paste the client ID/secret.
#   Supabase → Authentication → Email: keep "Confirm email" ON. Recovery links
#   use the implicit flow, so they work even when opened on another device.

# Expo app (if you still build the mobile client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- LLM providers (server-only) ---------------------------------------------
# Each character is routed through a different provider first so free tiers last.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash

# Last-resort fallback provider
GEMINI_API_KEY=

# Optional legacy providers
DEEPGRAM_API_KEY=
XAI_API_KEY=

# --- ElevenLabs (STT + TTS only, never an LLM) -------------------------------
# One key per character so each voice has its own quota.
ELEVENLABS_KEY_JEN=
ELEVENLABS_KEY_ADAM=
ELEVENLABS_KEY_GENTECH=
ELEVENLABS_KEY_KEVIN=
ELEVENLABS_KEY_MIKA=
# Optional shared fallback key
ELEVENLABS_API_KEY=

ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# Optional per-character, per-language voice overrides.
# The admin console (`ai_voice_profiles`) takes precedence over these.
# ELEVENLABS_VOICE_JEN_CEBUANO=
# ELEVENLABS_VOICE_JEN_FILIPINO=
# ELEVENLABS_VOICE_JEN_ENGLISH=
# ELEVENLABS_VOICE_ADAM=
# ELEVENLABS_VOICE_GENTECH=
# ELEVENLABS_VOICE_KEVIN=
# ELEVENLABS_VOICE_MIKA=

# --- Payments (learner top-ups) ----------------------------------------------
# Shown in the token store so learners know where to send GCash.
VITE_GCASH_NUMBER=

# --- NLP / BERT intent analysis ----------------------------------------------
# The offline TF-IDF/rule classifier always runs and is the fallback.
#
# Primary encoder: a real local ONNX export of the base
# google-bert/bert-base-multilingual-cased encoder. Build it once with:
#   npm run nlp:export-bert
# The exported graph is `last_hidden_state` (base BertModel), not the MLM head.
# Intent classification is similarity-based (frozen encoder, mean pooling,
# cosine vs. labelled exemplars); it is NOT fine-tuned. See
# models/bert/sulti-bert-base-multilingual-cased/sulti-model.json for provenance.
BERT_LOCAL_ENABLED=true
BERT_LOCAL_DIR=models/bert
BERT_LOCAL_MODEL_ID=sulti-bert-base-multilingual-cased
# fp32 is the default and is numerically exact vs PyTorch. Set q8 for lower
# memory (approx. 178 MB instead of 700 MB) with a small embedding drift.
BERT_DTYPE=fp32
BERT_MAX_LENGTH=128
BERT_BATCH_SIZE=16
BERT_LOAD_TIMEOUT_MS=120000
BERT_INFERENCE_TIMEOUT_MS=15000
BERT_ANALYZE_TIMEOUT_MS=30000
BERT_RETRY_MS=60000
# Warm the local encoder in the background after the HTTP server starts.
BERT_WARMUP=true
# Try local BERT on chat/voice turns with this budget; fall back to TF-IDF when
# the model is still loading. Hosted encoders are NOT called from chat unless
# BERT_CHAT_REMOTE_FALLBACK=true (keeps voice turns fast and offline-capable).
BERT_CHAT_ENABLED=true
BERT_CHAT_TIMEOUT_MS=700
BERT_CHAT_REMOTE_FALLBACK=false

# Optional hosted fallbacks. The token is server-side only (never VITE_/EXPO_).
# A read-only fine-grained token is enough to download public weights but may
# not have Inference Providers permission; a 403 simply skips this backend.
HF_TOKEN=
BERT_MODEL_ID=google-bert/bert-base-multilingual-cased
HF_INFERENCE_BASE=https://api-inference.huggingface.co/models
BERT_HOSTED_ENABLED=true
# NVIDIA Nemotron embeddings (uses NVIDIA_API_KEY) when HF is unavailable.
BERT_EMBED_MODEL_ID=nvidia/nemotron-3.5-embed-1b
BERT_NVIDIA_ENABLED=true
# Set true to disable all hosted encoders (local BERT and TF-IDF still work).
BERT_REMOTE_DISABLED=false
BERT_EMBED_TIMEOUT_MS=9000
# 0-1. Overrides system_config.bert_confidence_threshold when set.
BERT_CONFIDENCE_THRESHOLD=0.55
